// Resource nodes scattered by world generation: one per tile at most.
//   densities:  chance per tile in each biome
//   near_water: extra chance on tiles within 2 of a river or lake
//   clump:      how patchy (0 = even, 1 = strong groves and gaps)
//   blocks:     whether it blocks walking and building
//   amount:     how much it yields before it's used up
//   variants:   how many models it has (assets/models/<id>.glb, <id>_2.glb...)
[
    (id: "tree", name: "Broadleaf tree", amount: 40.0, variants: 2, blocks: true, clump: 0.9, near_water: 0.0, colour: "#2E6B2A",
     densities: [("forest", 0.16), ("meadow", 0.008), ("marsh", 0.02), ("hills", 0.02)]),
