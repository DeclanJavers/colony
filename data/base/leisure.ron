// Free time, hobbies and beauty (M7). Free-time activities are chosen like any other action once
// needs are met. Doing one adds to how much the person has enjoyed it (more when it suits their
// personality, and when they needed the fun); past its `hobby_joy` it becomes a hobby. Everyday
// pastimes (a stroll, a song) take more enjoyment to become a hobby than making things does.
(
    acts: [
        // A walk to a pleasant spot and back (the most beautiful spot nearby, when beauty matters).
        (id: "stroll", name: "Go for a stroll", minutes: 40, fun: 0.45, social: 0.0, skill: None,
         traits: [("curiosity", 0.6), ("calm", 0.3)], wood: 0, stone: 0, seasons: [true, true, true, true], hobby_joy: 6.0),
        // By the fire, best with others there.
        (id: "sing", name: "Sing by the fire", minutes: 40, fun: 0.4, social: 0.3, skill: Some("singing"),
         traits: [("sociability", 0.7), ("warmth", 0.2)], wood: 0, stone: 0, seasons: [true, true, true, true], hobby_joy: 5.0),
        // Plant a flower bed by home (or by the fire, for someone without one).
        (id: "garden", name: "Plant flowers", minutes: 60, fun: 0.4, social: 0.0, skill: Some("gardening"),
         traits: [("warmth", 0.5), ("diligence", 0.3)], wood: 0, stone: 0, seasons: [true, true, false, false], hobby_joy: 2.5),
        // Whittle a piece of wood; a skilled carver makes a statue and sets it up.
        (id: "carve", name: "Carve some wood", minutes: 90, fun: 0.5, social: 0.0, skill: Some("carving"),
         traits: [("curiosity", 0.4), ("calm", 0.5)], wood: 1, stone: 0, seasons: [true, true, true, true], hobby_joy: 2.5),
        // Improve your home a step: stones laid to the door, then flower boxes, then carved posts.
        (id: "decorate", name: "Decorate home", minutes: 90, fun: 0.35, social: 0.0, skill: None,
         traits: [("diligence", 0.6), ("warmth", 0.2)], wood: 1, stone: 2, seasons: [true, true, true, false], hobby_joy: 2.5),
    ],
    // How many hobbies one person has.
    max_hobbies: 2,
    // A hobby appeals this much more, and gives this much more fun.
    hobby_appeal: 0.18,
    hobby_fun: 1.3,
    // From this carving level a carving is a statue (set up in the world), not a trinket.
    statue_level: 2,
    // How far from home (or the fire) people plant flowers and set up statues.
    place_radius: 4,
    beauty: (
        // Node kind: beauty at the source, radius in tiles, and beauty in winter.
        sources: [("wildflowers", 0.22, 2.5, 0.04), ("flower_bed", 0.5, 3.0, 0.1), ("carving", 0.4, 4.0, 0.4)],
        // A statue is this much more beautiful per carving level of whoever made it.
        statue_per_level: 0.05,
        // A home's decoration, each step (stones, flower boxes, carved posts), adds this.
        decor: [0.15, 0.3, 0.45],
        decor_radius: 3.5,
        // When beauty matters: mood points at full beauty, and boredom eased per hour at full beauty.
        mood: 6.0,
        fun_per_hour: 0.03,
    ),
)
